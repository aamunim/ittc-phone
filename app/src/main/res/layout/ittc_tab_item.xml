<?xml version="1.0" encoding="utf-8"?>
<!-- 🎓 ITTC 3.8: a tab of the bottom bar: the icon (on a soft accent pill when chosen, as in
     Material 3, the pill fading / growing in) above its label, and a small red count (missed
     calls, leads due) at the icon's top end. The ids tab_item_icon / tab_item_label are commons'
     bottom_tablayout_item's, so the code that finds a tab's icon and label works with either.
     Colours are set in MainActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tab_item_holder"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ittc_tab_height"
    android:gravity="center"
    android:minHeight="48dp"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/ittc_tab_icon_box"
        android:layout_width="64dp"
        android:layout_height="32dp"
        android:clipChildren="false">

        <!-- the chosen tab's pill (alpha / scale animated; its own view so the icon never scales) -->
        <View
            android:id="@+id/ittc_tab_pill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleX="0.6" />

        <ImageView
            android:id="@+id/tab_item_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_person_vector" />

        <TextView
            android:id="@+id/ittc_tab_badge"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="38dp"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minWidth="16dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textSize="10dp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="3"
            tools:visibility="visible" />
    </FrameLayout>

    <TextView
        android:id="@+id/tab_item_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_horizontal"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textSize="12sp"
        tools:text="@string/contacts_tab" />

</LinearLayout>
