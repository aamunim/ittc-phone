<?xml version="1.0" encoding="utf-8"?>
<!-- 🎓 ITTC 3.5: one lead — a blue hero (who), the stage card (stepper, next call), the big actions,
     the chips row, the visit / fee and admission cards (filled by IttcLeadExtras / IttcAdmitCard),
     notes and the timeline. Colours come from IttcTheme in code; rows are added in code. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ittc_lead_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ittc_bg">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/ittc_lead_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/ittc_lead_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/ittc_primary"
            app:title=""
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle">

            <!-- (scrolled past the hero's Call: the name · 📞 · WhatsApp) ★ rating · ⋮ more -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ittc_lead_bar_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="invisible"
                    tools:text="Lead name" />

                <ImageView
                    android:id="@+id/ittc_lead_bar_call"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ittc_lp_call"
                    android:padding="11dp"
                    android:src="@drawable/ic_phone_vector"
                    android:visibility="invisible" />

                <ImageView
                    android:id="@+id/ittc_lead_bar_whatsapp"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ittc_lp_whatsapp"
                    android:padding="11dp"
                    android:src="@drawable/ittc_ic_whatsapp"
                    android:visibility="invisible" />

                <ImageView
                    android:id="@+id/ittc_lead_star"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ittc_b_rating"
                    android:padding="11dp"
                    android:src="@drawable/ic_star_outline_vector" />

                <ImageView
                    android:id="@+id/ittc_lead_more"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/ittc_b_more"
                    android:padding="11dp"
                    android:src="@drawable/ic_three_dots_vector" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/ittc_lead_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/ittc_lead_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/ittc_space_xl">

            <!-- 🟦 the hero: avatar, name, number · course · batch, rating · AI chance · owner -->
            <LinearLayout
                android:id="@+id/ittc_lead_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/ittc_primary"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ittc_space_l"
                android:paddingTop="4dp"
                android:paddingEnd="@dimen/ittc_space_l"
                android:paddingBottom="30dp">

                <TextView
                    android:id="@+id/ittc_lead_avatar"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="RH" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/ittc_lead_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textIsSelectable="true"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        tools:text="Lead name" />

                    <TextView
                        android:id="@+id/ittc_lead_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/ittc_touch"
                        android:textSize="13sp"
                        tools:text="01711-000000 · CSE · Batch 2027" />

                    <TextView
                        android:id="@+id/ittc_lead_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        tools:text="Hot · AI chance 72% · Assigned to you" />
                </LinearLayout>
            </LinearLayout>

            <!-- the stage card (overlaps the hero): stepper, next call, change stage -->
            <LinearLayout
                android:id="@+id/ittc_lead_stage_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ittc_space_l"
                android:layout_marginTop="-18dp"
                android:layout_marginEnd="@dimen/ittc_space_l"
                android:background="@drawable/ittc_bg_card"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <!-- the steps (added in code) -->
                <LinearLayout
                    android:id="@+id/ittc_lead_stepper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />

                <View
                    android:id="@+id/ittc_lead_stage_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ittc_lead_next"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:minHeight="@dimen/ittc_touch"
                        android:gravity="center_vertical"
                        android:textSize="13sp"
                        tools:text="Next call Today 10:30 AM" />

                    <TextView
                        android:id="@+id/ittc_lead_change_stage"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/ittc_touch"
                        android:layout_marginStart="8dp"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="@string/ittc_b_change_stage"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- "Offline — showing saved info" / errors -->
            <TextView
                android:id="@+id/ittc_lead_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/ittc_space_l"
                android:paddingTop="@dimen/ittc_space_s"
                android:paddingEnd="@dimen/ittc_space_l"
                android:text="@string/ittc_lp_loading"
                android:textSize="13sp"
                android:textStyle="italic" />

            <!-- call / WhatsApp / SMS / note -->
            <LinearLayout
                android:id="@+id/ittc_lead_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/ittc_lead_call"
                    style="@style/IttcLeadAction"
                    android:text="@string/ittc_lp_call" />

                <TextView
                    android:id="@+id/ittc_lead_whatsapp"
                    style="@style/IttcLeadAction"
                    android:text="@string/ittc_lp_whatsapp" />

                <TextView
                    android:id="@+id/ittc_lead_sms"
                    style="@style/IttcLeadAction"
                    android:text="@string/ittc_lp_sms" />

                <TextView
                    android:id="@+id/ittc_lead_note"
                    style="@style/IttcLeadAction"
                    android:text="@string/ittc_b_note" />
            </LinearLayout>

            <!-- book visit · fee · papers · payment · admit · templates · … (added in code) -->
            <HorizontalScrollView
                android:id="@+id/ittc_lead_chips_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ittc_lead_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ittc_space_l"
                    android:paddingTop="6dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="10dp" />
            </HorizontalScrollView>

            <!-- the lead's numbers when it has more than one (tap: call) -->
            <LinearLayout
                android:id="@+id/ittc_lead_numbers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ittc_space_l"
                android:layout_marginEnd="@dimen/ittc_space_l"
                android:layout_marginBottom="@dimen/ittc_space_s"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:visibility="gone" />

            <!-- 🏫 visit and fee (Part C: IttcLeadExtras) -->
            <LinearLayout
                android:id="@+id/ittc_lead_extras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/ittc_space_l"
                android:paddingEnd="@dimen/ittc_space_l" />

            <!-- 🎓 admission, payments, papers (Part D: IttcAdmitCard) -->
            <LinearLayout
                android:id="@+id/ittc_lead_admit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/ittc_space_l"
                android:paddingEnd="@dimen/ittc_space_l" />

            <TextView
                android:id="@+id/ittc_lead_notes_label"
                style="@style/IttcLeadSection"
                android:text="@string/ittc_b_notes_head"
                android:visibility="gone" />

            <!-- the lead's notes (tap: all of them) -->
            <TextView
                android:id="@+id/ittc_lead_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ittc_space_l"
                android:layout_marginEnd="@dimen/ittc_space_l"
                android:ellipsize="end"
                android:maxLines="6"
                android:padding="12dp"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- calls and changes by day, newest first (added in code) -->
            <LinearLayout
                android:id="@+id/ittc_lead_timeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/ittc_space_l"
                android:paddingEnd="@dimen/ittc_space_l" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
