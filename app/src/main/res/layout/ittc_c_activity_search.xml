<?xml version="1.0" encoding="utf-8"?>
<!-- 🔎 ITTC 3.4: search every lead I may see (closed ones too), Recent / Starred when empty -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ittc_c_search_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/ittc_c_search_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/ittc_c_search_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/ittc_search_title"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <LinearLayout
        android:id="@+id/ittc_c_search_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <EditText
            android:id="@+id/ittc_c_search_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ittc_space_l"
            android:layout_marginTop="@dimen/ittc_space_m"
            android:layout_marginEnd="@dimen/ittc_space_l"
            android:hint="@string/ittc_c_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:minHeight="48dp"
            android:paddingStart="@dimen/ittc_space_l"
            android:paddingEnd="@dimen/ittc_space_l"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/ittc_c_search_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ittc_space_l"
            android:layout_marginTop="@dimen/ittc_space_s"
            android:layout_marginEnd="@dimen/ittc_space_l"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ittc_c_search_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/ittc_space_l"
                android:paddingTop="@dimen/ittc_space_s"
                android:paddingEnd="@dimen/ittc_space_l"
                android:paddingBottom="@dimen/ittc_space_l"
                android:scrollbars="none" />

            <TextView
                android:id="@+id/ittc_c_search_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/ittc_space_xl"
                android:textSize="@dimen/ittc_text_body"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/ittc_c_search_progress"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/ittc_space_l"
                android:indeterminate="true"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
