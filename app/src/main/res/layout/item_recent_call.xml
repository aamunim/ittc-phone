<?xml version="1.0" encoding="utf-8"?>
<!-- 🎓 ITTC 3.5: one Recents row, a piece of the day's card — a lead's coloured bar, avatar, name
     (N) + stage pill / "2 missed", "Outgoing · 4m 12s · CSE", the time, → call history, ⋮.
     3.11.1: a saved contact's name in full (two lines, a long one a little smaller); a number not
     saved that is a lead: the lead's name in small text under it.
     (also the "Show call details" dialog's rows, there without the card) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_recents_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/ittc_space_l"
    android:layout_marginEnd="@dimen/ittc_space_l"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="66dp">

    <!-- the line between two rows of one card -->
    <View
        android:id="@+id/item_recents_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="66dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- a lead: the stage's colour on the left -->
    <View
        android:id="@+id/item_recents_bar"
        android:layout_width="4dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- a contact's photo; no photo: the initials below -->
    <ImageView
        android:id="@+id/item_recents_image"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="@dimen/ittc_space_m"
        android:contentDescription="@null"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_recents_avatar"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="@dimen/ittc_space_m"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="RH" />

    <TextView
        android:id="@+id/item_recents_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="66dp"
        android:layout_marginTop="@dimen/ittc_space_m"
        android:breakStrategy="simple"
        android:ellipsize="end"
        android:hyphenationFrequency="none"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:textDirection="firstStrongLtr"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/item_recents_lead_name"
        app:layout_constraintEnd_toStartOf="@+id/item_recents_count"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Rahim Hasan" />

    <TextView
        android:id="@+id/item_recents_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintBaseline_toBaselineOf="@+id/item_recents_name"
        app:layout_constraintEnd_toStartOf="@+id/item_recents_pill"
        app:layout_constraintStart_toEndOf="@+id/item_recents_name"
        tools:text="(3)"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/item_recents_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="@dimen/ittc_space_s"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="7dp"
        android:paddingTop="1dp"
        android:paddingEnd="7dp"
        android:paddingBottom="1dp"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBaseline_toBaselineOf="@+id/item_recents_name"
        app:layout_constraintEnd_toStartOf="@+id/item_recents_date_time"
        app:layout_constraintStart_toEndOf="@+id/item_recents_count"
        tools:text="Interested"
        tools:visibility="visible" />

    <!-- 3.11.1: a number not in the contacts that is a lead: the lead's name, small, under the number -->
    <TextView
        android:id="@+id/item_recents_lead_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="66dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="@dimen/ittc_space_s"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/item_recents_info"
        app:layout_constraintEnd_toStartOf="@+id/item_recents_date_time"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/item_recents_name"
        tools:text="Rahim Hasan"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/item_recents_type"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="66dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_call_missed_vector"
        app:layout_constraintBottom_toBottomOf="@+id/item_recents_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/item_recents_info" />

    <ImageView
        android:id="@+id/item_recents_sim_image"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="@dimen/ittc_space_xs"
        android:alpha="0.6"
        android:contentDescription="@null"
        android:src="@drawable/ic_sim_vector"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/item_recents_info"
        app:layout_constraintStart_toEndOf="@+id/item_recents_type"
        app:layout_constraintTop_toTopOf="@+id/item_recents_info"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/item_recents_sim_id"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:textColor="@color/md_grey_black"
        android:textSize="9sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/item_recents_sim_image"
        app:layout_constraintEnd_toEndOf="@+id/item_recents_sim_image"
        app:layout_constraintStart_toStartOf="@+id/item_recents_sim_image"
        app:layout_constraintTop_toTopOf="@+id/item_recents_sim_image"
        tools:text="1"
        tools:visibility="visible" />

    <!-- "Outgoing · 4m 12s · CSE" (+ the place of a number from abroad) -->
    <TextView
        android:id="@+id/item_recents_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ittc_space_xs"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="@dimen/ittc_space_s"
        android:layout_marginBottom="@dimen/ittc_space_m"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/item_recents_date_time"
        app:layout_constraintStart_toEndOf="@+id/item_recents_sim_image"
        app:layout_constraintTop_toBottomOf="@+id/item_recents_lead_name"
        tools:text="Outgoing · 4m 12s · CSE" />

    <TextView
        android:id="@+id/item_recents_date_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/ittc_space_xs"
        android:maxLines="1"
        android:textSize="12sp"
        app:layout_goneMarginEnd="@dimen/ittc_space_m"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/item_recents_history"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="9:12 AM" />

    <!-- → this number's call history (a tap on the row calls); a 44 dp touch area, the circle
         drawn 36 dp (its background is inset in code) -->
    <ImageView
        android:id="@+id/item_recents_history"
        android:layout_width="@dimen/ittc_touch"
        android:layout_height="@dimen/ittc_touch"
        android:contentDescription="@string/ittc_a_call_history"
        android:padding="13dp"
        android:src="@drawable/ic_arrow_right_vector"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/overflow_menu_icon"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/overflow_menu_icon"
        style="@style/OverflowMenuIconStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/more_options"
        android:paddingStart="6dp"
        android:paddingEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/overflow_menu_anchor"
        style="@style/OverflowMenuAnchorStyle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
