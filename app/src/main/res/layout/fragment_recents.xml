<?xml version="1.0" encoding="utf-8"?>
<org.fossify.phone.fragments.RecentsFragment xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recents_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🎓 ITTC 3.8: All / Leads (only the calls with a lead) / Missed / Incoming / Outgoing, icon-only
         pills (the name: long-press tooltip and TalkBack); Missed carries today's missed count -->
    <HorizontalScrollView
        android:id="@+id/ittc_recents_filters_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ittc_recents_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ittc_space_l"
            android:paddingTop="6dp"
            android:paddingEnd="@dimen/ittc_space_l"
            android:paddingBottom="@dimen/ittc_space_xs">

            <ImageView
                android:id="@+id/ittc_recents_kind_all"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:layout_marginEnd="@dimen/ittc_space_s"
                android:contentDescription="@string/ittc_hist_all"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ittc_ic_filter_all"
                android:tooltipText="@string/ittc_hist_all" />

            <!-- 🎓 ITTC: show only lead calls (on / off, with any of the others) -->
            <ImageView
                android:id="@+id/ittc_recents_leads_only"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:layout_marginEnd="@dimen/ittc_space_s"
                android:contentDescription="@string/ittc_a_leads_chip"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ittc_ic_leads"
                android:tooltipText="@string/ittc_a_leads_chip" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ittc_space_s"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/ittc_recents_kind_missed"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/ittc_hist_missed"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_call_missed_vector"
                    android:tooltipText="@string/ittc_hist_missed" />

                <!-- today's missed calls (hidden at 0) -->
                <TextView
                    android:id="@+id/ittc_recents_missed_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-4dp"
                    android:layout_marginEnd="-4dp"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minWidth="16dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageView
                android:id="@+id/ittc_recents_kind_incoming"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:layout_marginEnd="@dimen/ittc_space_s"
                android:contentDescription="@string/ittc_hist_incoming"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_call_received_vector"
                android:tooltipText="@string/ittc_hist_incoming" />

            <ImageView
                android:id="@+id/ittc_recents_kind_outgoing"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:layout_marginEnd="@dimen/ittc_space_s"
                android:contentDescription="@string/ittc_hist_outgoing"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_call_made_vector"
                android:tooltipText="@string/ittc_hist_outgoing" />
        </LinearLayout>
    </HorizontalScrollView>

    <org.fossify.commons.views.MyTextView
        android:id="@+id/recents_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ittc_recents_filters_scroll"
        android:layout_centerHorizontal="true"
        android:alpha="0.8"
        android:gravity="center"
        android:paddingStart="@dimen/activity_margin"
        android:paddingTop="@dimen/activity_margin"
        android:paddingEnd="@dimen/activity_margin"
        android:text="@string/no_previous_calls"
        android:textSize="@dimen/bigger_text_size"
        android:textStyle="italic"
        android:visibility="gone" />

    <org.fossify.commons.views.MyTextView
        android:id="@+id/recents_placeholder_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/recents_placeholder"
        android:layout_centerHorizontal="true"
        android:background="@drawable/ripple_all_corners"
        android:gravity="center"
        android:padding="@dimen/activity_margin"
        android:text="@string/request_access"
        android:textSize="@dimen/bigger_text_size"
        android:visibility="gone" />

    <org.fossify.commons.views.MyRecyclerView
        android:id="@+id/recents_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/ittc_recents_filters_scroll"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/layout_animation"
        android:paddingBottom="@dimen/recyclerview_fab_padding"
        android:scrollbars="none"
        app:layoutManager="org.fossify.commons.views.MyLinearLayoutManager" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        app:trackCornerRadius="@dimen/small_margin" />
</org.fossify.phone.fragments.RecentsFragment>
