<?xml version="1.0" encoding="utf-8"?>
<!-- 🎓 ITTC Phone 3.2: the ITTC account — sign in (works without the Tracker), status, switches, sign out -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ittc_account_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/ittc_account_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/ittc_account_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/ittc_account_title"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/ittc_account_scrollview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/ittc_account_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/activity_margin">

            <!-- this build has no ITTC address / key -->
            <org.fossify.commons.views.MyTextView
                android:id="@+id/ittc_account_not_configured"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/activity_margin"
                android:text="@string/ittc_account_not_configured"
                android:textSize="@dimen/bigger_text_size"
                android:visibility="gone" />

            <!-- why the last sign-out happened ("An admin signed you out"), once -->
            <TextView
                android:id="@+id/ittc_account_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/activity_margin"
                android:layout_marginTop="@dimen/activity_margin"
                android:layout_marginEnd="@dimen/activity_margin"
                android:textColor="@color/md_red_700"
                android:textSize="@dimen/bigger_text_size"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- too old for the admin: update from Google Play -->
            <LinearLayout
                android:id="@+id/ittc_account_update_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/activity_margin"
                android:background="@color/md_red_700"
                android:orientation="vertical"
                android:padding="@dimen/activity_margin"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ittc_account_update_needed"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/bigger_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tiny_margin"
                    android:text="@string/ittc_account_update_needed_note"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/normal_text_size" />

                <Button
                    android:id="@+id/ittc_account_open_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/medium_margin"
                    android:text="@string/ittc_account_open_play" />
            </LinearLayout>

            <!-- signed out: email + password -->
            <LinearLayout
                android:id="@+id/ittc_account_signed_out_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/activity_margin"
                android:visibility="gone">

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/ittc_account_explain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ittc_account_explain"
                    android:textSize="@dimen/normal_text_size" />

                <org.fossify.commons.views.MyTextInputLayout
                    android:id="@+id/ittc_account_email_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_margin"
                    android:hint="@string/ittc_account_email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ittc_account_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:singleLine="true"
                        android:textCursorDrawable="@null"
                        android:textSize="@dimen/bigger_text_size" />

                </org.fossify.commons.views.MyTextInputLayout>

                <org.fossify.commons.views.MyTextInputLayout
                    android:id="@+id/ittc_account_password_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/medium_margin"
                    android:hint="@string/ittc_account_password"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ittc_account_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="password"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:textCursorDrawable="@null"
                        android:textSize="@dimen/bigger_text_size" />

                </org.fossify.commons.views.MyTextInputLayout>

                <Button
                    android:id="@+id/ittc_account_sign_in"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_margin"
                    android:minHeight="56dp"
                    android:text="@string/ittc_account_sign_in"
                    android:textSize="@dimen/bigger_text_size" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/ittc_account_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/medium_margin"
                    android:alpha="0.7"
                    android:text="@string/ittc_account_signing_in"
                    android:textSize="@dimen/normal_text_size"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/ittc_account_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/medium_margin"
                    android:textColor="@color/md_red_700"
                    android:textSize="@dimen/normal_text_size"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- signed in: who, how it works now, last update, waiting calls -->
            <LinearLayout
                android:id="@+id/ittc_account_signed_in_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/activity_margin"
                android:visibility="gone">

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/ittc_account_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/ittc_account_email_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:textSize="@dimen/normal_text_size" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/ittc_account_role"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:textSize="@dimen/normal_text_size" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/ittc_account_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/activity_margin"
                    android:textSize="@dimen/bigger_text_size" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/ittc_account_last_updated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tiny_margin"
                    android:alpha="0.7"
                    android:textSize="@dimen/normal_text_size" />

                <TextView
                    android:id="@+id/ittc_account_refresh_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/tiny_margin"
                    android:textColor="@color/md_red_700"
                    android:textSize="@dimen/normal_text_size"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/ittc_account_pending_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/medium_margin"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/ittc_account_pending"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/normal_text_size" />

                    <Button
                        android:id="@+id/ittc_account_send_now"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ittc_account_send_now" />
                </LinearLayout>

                <Button
                    android:id="@+id/ittc_account_update_now"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/medium_margin"
                    android:text="@string/ittc_account_update_now" />
            </LinearLayout>

            <!-- run without the Tracker (only when the Tracker is installed) -->
            <LinearLayout
                android:id="@+id/ittc_account_prefer_direct_holder"
                style="@style/SettingsHolderSwitchStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <org.fossify.commons.views.MyMaterialSwitch
                    android:id="@+id/ittc_account_prefer_direct"
                    style="@style/SettingsSwitchStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ittc_account_prefer_direct" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/ittc_account_prefer_direct_note"
                    style="@style/SettingsTextValueStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/bigger_margin"
                    android:text="@string/ittc_account_prefer_direct_note"
                    android:textSize="@dimen/smaller_text_size" />
            </LinearLayout>

            <!-- follow-up reminders (with or without the Tracker) -->
            <RelativeLayout
                android:id="@+id/ittc_account_reminders_holder"
                style="@style/SettingsHolderSwitchStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <org.fossify.commons.views.MyMaterialSwitch
                    android:id="@+id/ittc_account_reminders"
                    style="@style/SettingsSwitchStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ittc_account_reminders" />

            </RelativeLayout>

            <!-- after a call with an unknown number: "Add as a lead" (signed in only) -->
            <RelativeLayout
                android:id="@+id/ittc_account_unknown_after_call_holder"
                style="@style/SettingsHolderSwitchStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <org.fossify.commons.views.MyMaterialSwitch
                    android:id="@+id/ittc_account_unknown_after_call"
                    style="@style/SettingsSwitchStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ittc_account_unknown_after_call" />

            </RelativeLayout>

            <Button
                android:id="@+id/ittc_account_sign_out"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/activity_margin"
                android:text="@string/ittc_account_sign_out"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
