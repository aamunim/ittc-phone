<?xml version="1.0" encoding="utf-8"?>
<!-- 🎓 ITTC: one call on the call history page, a small card: direction, kind · duration, time, SIM -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ittc_call_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/ittc_space_l"
    android:layout_marginTop="@dimen/ittc_space_xs"
    android:layout_marginEnd="@dimen/ittc_space_l"
    android:layout_marginBottom="@dimen/ittc_space_xs"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/ittc_space_m">

    <ImageView
        android:id="@+id/ittc_call_type"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@null"
        android:padding="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ittc_space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ittc_call_kind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ittc_call_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ittc_call_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ittc_call_sim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ittc_space_s"
        android:maxLines="1"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
