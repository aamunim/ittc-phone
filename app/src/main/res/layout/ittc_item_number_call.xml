<?xml version="1.0" encoding="utf-8"?>
<!-- 🎓 ITTC: one call on the call history page: direction, time, duration, SIM -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ittc_call_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/activity_margin"
    android:paddingTop="@dimen/medium_margin"
    android:paddingEnd="@dimen/activity_margin"
    android:paddingBottom="@dimen/medium_margin">

    <ImageView
        android:id="@+id/ittc_call_type"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/ittc_call_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/medium_margin"
        android:maxLines="1"
        android:textSize="@dimen/bigger_text_size" />

    <TextView
        android:id="@+id/ittc_call_kind"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/medium_margin"
        android:layout_weight="1"
        android:alpha="0.7"
        android:maxLines="1"
        android:textSize="@dimen/normal_text_size" />

    <TextView
        android:id="@+id/ittc_call_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/medium_margin"
        android:alpha="0.7"
        android:maxLines="1"
        android:textSize="@dimen/normal_text_size" />

    <TextView
        android:id="@+id/ittc_call_sim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/medium_margin"
        android:maxLines="1"
        android:textSize="@dimen/smaller_text_size"
        android:visibility="gone" />
</LinearLayout>
