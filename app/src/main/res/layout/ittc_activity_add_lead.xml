<?xml version="1.0" encoding="utf-8"?>
<!-- 🎓 ITTC direct mode: add a lead (name, numbers, course, a note). 3.5: cards on the soft
     background, course pills, a round Save button (colours set in code) -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ittc_add_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/ittc_add_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/ittc_add_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/ittc_add_lead_title"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/ittc_add_scrollview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/ittc_add_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/ittc_space_l">

            <!-- who: name and numbers -->
            <TextView
                android:id="@+id/ittc_add_person_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ittc_space_s"
                android:letterSpacing="0.04"
                android:text="@string/ittc_b_add_who"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/ittc_add_person_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ittc_space_m">

            <org.fossify.commons.views.MyEditText
                android:id="@+id/ittc_add_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ittc_al_name"
                android:inputType="textPersonName|textCapWords"
                android:textSize="@dimen/bigger_text_size" />

            <org.fossify.commons.views.MyEditText
                android:id="@+id/ittc_add_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                android:hint="@string/ittc_al_phone"
                android:inputType="phone"
                android:textSize="@dimen/bigger_text_size" />

            <org.fossify.commons.views.MyEditText
                android:id="@+id/ittc_add_alt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                android:hint="@string/ittc_al_alt_phone"
                android:inputType="phone"
                android:textSize="@dimen/bigger_text_size" />

            <org.fossify.commons.views.MyAppCompatCheckbox
                android:id="@+id/ittc_add_same_whatsapp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                android:checked="true"
                android:text="@string/ittc_al_same_whatsapp" />

            <org.fossify.commons.views.MyEditText
                android:id="@+id/ittc_add_whatsapp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ittc_al_whatsapp"
                android:inputType="phone"
                android:textSize="@dimen/bigger_text_size"
                android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/ittc_add_course_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ittc_space_l"
                android:layout_marginBottom="@dimen/ittc_space_s"
                android:letterSpacing="0.04"
                android:text="@string/ittc_al_course"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/ittc_add_course_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ittc_space_m">

            <!-- the courses as chips (added in code) / loading / error with "Try again" -->
            <org.fossify.commons.views.MyTextView
                android:id="@+id/ittc_add_course_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                android:alpha="0.8"
                android:text="@string/ittc_lp_loading"
                android:textSize="@dimen/normal_text_size" />

            <LinearLayout
                android:id="@+id/ittc_add_courses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ittc_add_note_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ittc_space_l"
                android:orientation="vertical"
                android:padding="@dimen/ittc_space_m">

                <org.fossify.commons.views.MyEditText
                    android:id="@+id/ittc_add_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/ittc_al_note"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="5"
                    android:textSize="@dimen/bigger_text_size" />
            </LinearLayout>

            <org.fossify.commons.views.MyTextView
                android:id="@+id/ittc_add_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:textColor="@color/md_red_700"
                android:textSize="@dimen/normal_text_size"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ittc_add_save"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="@dimen/ittc_space_l"
                android:gravity="center"
                android:text="@string/ittc_al_save"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
