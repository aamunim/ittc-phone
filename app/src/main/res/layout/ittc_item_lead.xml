<?xml version="1.0" encoding="utf-8"?>
<!-- 🎓 ITTC: one lead in the "Leads" tab -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ittc_lead_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/activity_margin"
    android:paddingTop="@dimen/medium_margin"
    android:paddingBottom="@dimen/medium_margin">

    <View
        android:id="@+id/ittc_lead_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginEnd="@dimen/medium_margin"
        android:background="@drawable/circle_background" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ittc_lead_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="@dimen/bigger_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ittc_lead_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="@dimen/normal_text_size" />

        <TextView
            android:id="@+id/ittc_lead_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="@dimen/normal_text_size"
            android:textStyle="italic" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ittc_lead_call"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/call_number"
        android:padding="@dimen/normal_margin"
        android:src="@drawable/ic_phone_vector" />
</LinearLayout>
