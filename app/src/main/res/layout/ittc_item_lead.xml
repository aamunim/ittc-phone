<?xml version="1.0" encoding="utf-8"?>
<!-- 🎓 ITTC: one lead in the "Leads" tab — a card: avatar, name + stage pill, course · next call,
     the last note, 📞. Swipe right: call; swipe left: the next call. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ittc_lead_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/ittc_space_l"
    android:paddingTop="5dp"
    android:paddingEnd="@dimen/ittc_space_l"
    android:paddingBottom="5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ittc_lead_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ittc_bg_card"
        android:foreground="?attr/selectableItemBackground"
        android:minHeight="72dp"
        android:padding="14dp">

        <TextView
            android:id="@+id/ittc_lead_avatar"
            android:layout_width="@dimen/ittc_touch"
            android:layout_height="@dimen/ittc_touch"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="RH" />

        <TextView
            android:id="@+id/ittc_lead_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ittc_space_m"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@+id/ittc_lead_line"
            app:layout_constraintEnd_toStartOf="@+id/ittc_lead_stage"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/ittc_lead_avatar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Rahim Hasan" />

        <TextView
            android:id="@+id/ittc_lead_stage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ittc_space_s"
            android:layout_marginEnd="@dimen/ittc_space_s"
            android:maxLines="1"
            android:paddingStart="@dimen/ittc_space_s"
            android:paddingTop="2dp"
            android:paddingEnd="@dimen/ittc_space_s"
            android:paddingBottom="2dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBaseline_toBaselineOf="@+id/ittc_lead_name"
            app:layout_constraintEnd_toStartOf="@+id/ittc_lead_call"
            app:layout_constraintStart_toEndOf="@+id/ittc_lead_name"
            tools:text="Interested"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/ittc_lead_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ittc_space_m"
            android:layout_marginTop="@dimen/ittc_space_xs"
            android:layout_marginEnd="@dimen/ittc_space_s"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@+id/ittc_lead_note"
            app:layout_constraintEnd_toStartOf="@+id/ittc_lead_call"
            app:layout_constraintStart_toEndOf="@+id/ittc_lead_avatar"
            app:layout_constraintTop_toBottomOf="@+id/ittc_lead_name"
            tools:text="CSE · Next call 10:30 AM" />

        <TextView
            android:id="@+id/ittc_lead_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ittc_space_m"
            android:layout_marginTop="@dimen/ittc_space_xs"
            android:layout_marginEnd="@dimen/ittc_space_s"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ittc_lead_call"
            app:layout_constraintStart_toEndOf="@+id/ittc_lead_avatar"
            app:layout_constraintTop_toBottomOf="@+id/ittc_lead_line"
            tools:text="“Will talk with family, call after 10”" />

        <ImageView
            android:id="@+id/ittc_lead_call"
            android:layout_width="@dimen/ittc_touch"
            android:layout_height="@dimen/ittc_touch"
            android:contentDescription="@string/call_number"
            android:padding="12dp"
            android:src="@drawable/ic_phone_vector"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
