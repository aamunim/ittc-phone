<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MySearchMenu
        android:id="@+id/main_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- 🎓 ITTC 3.2: the admin needs a newer version (signed in only); a tap opens Google Play -->
        <TextView
            android:id="@+id/ittc_update_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/md_red_700"
            android:foreground="?attr/selectableItemBackground"
            android:paddingStart="@dimen/activity_margin"
            android:paddingTop="@dimen/medium_margin"
            android:paddingEnd="@dimen/activity_margin"
            android:paddingBottom="@dimen/medium_margin"
            android:text="@string/ittc_update_banner"
            android:textColor="#FFFFFFFF"
            android:textSize="@dimen/normal_text_size"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <org.fossify.commons.views.MyViewPager
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/main_tabs_holder"
            app:layout_constraintTop_toBottomOf="@+id/ittc_update_banner" />

        <!-- 🎓 ITTC 3.6: what the main screen's dial pad matches (leads, unsaved recent numbers,
             then contacts), over the list while a number is typed -->
        <LinearLayout
            android:id="@+id/ittc_dial_results"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clickable="true"
            android:focusable="false"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@+id/ittc_main_dialpad"
            app:layout_constraintTop_toBottomOf="@+id/ittc_update_banner">

            <TextView
                android:id="@+id/ittc_dial_lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:paddingStart="@dimen/activity_margin"
                android:paddingTop="@dimen/medium_margin"
                android:paddingEnd="@dimen/activity_margin"
                android:paddingBottom="@dimen/medium_margin"
                android:textSize="@dimen/bigger_text_size"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/ittc_dial_matches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <org.fossify.commons.views.MyRecyclerView
                android:id="@+id/ittc_dial_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:scrollbars="none"
                app:layoutManager="org.fossify.commons.views.MyLinearLayoutManager" />
        </LinearLayout>

        <org.fossify.commons.views.MyFloatingActionButton
            android:id="@+id/main_dialpad_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/bigger_margin"
            android:layout_marginBottom="@dimen/activity_margin"
            android:contentDescription="@string/dialpad"
            android:elevation="@dimen/medium_margin"
            android:padding="@dimen/activity_margin"
            android:src="@drawable/ic_dialpad_vector"
            app:backgroundTint="@color/color_primary"
            app:layout_constraintBottom_toTopOf="@+id/main_tabs_holder"
            app:layout_constraintEnd_toEndOf="parent"
            app:rippleColor="@color/pressed_item_foreground" />

        <!-- 🎓 ITTC 3.6: the dial pad, open at start, above the tab bar (never taller than the room
             under the top bar; IttcMainDialpad sizes the keys so it fits with room for matches) -->
        <include
            android:id="@+id/ittc_main_dialpad"
            layout="@layout/ittc_main_dialpad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/ittc_tabs_divider"
            app:layout_constraintTop_toBottomOf="@+id/ittc_update_banner"
            app:layout_constraintVertical_bias="1" />

        <!-- 🎓 ITTC 3.6: the tab bar's thin top line -->
        <View
            android:id="@+id/ittc_tabs_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintBottom_toTopOf="@+id/main_tabs_holder" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/main_tabs_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:tabGravity="fill"
            app:tabIndicator="@null"
            app:tabMinWidth="0dp"
            app:tabMode="fixed"
            app:tabPaddingBottom="0dp"
            app:tabPaddingEnd="0dp"
            app:tabPaddingStart="0dp"
            app:tabPaddingTop="0dp"
            app:tabRippleColor="@null" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
