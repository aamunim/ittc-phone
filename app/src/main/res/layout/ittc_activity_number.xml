<?xml version="1.0" encoding="utf-8"?>
<!-- 🎓 ITTC: one number's call history — header, actions, summary, every call by day -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ittc_number_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/ittc_number_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/ittc_number_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/ittc_hist_title"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/ittc_number_scrollview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/ittc_number_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/activity_margin">

            <!-- header: photo (or initials), name, number, the lead line -->
            <LinearLayout
                android:id="@+id/ittc_number_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/activity_margin">

                <ImageView
                    android:id="@+id/ittc_number_photo"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/activity_margin"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/ittc_number_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/ittc_number_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:alpha="0.7"
                        android:textIsSelectable="true"
                        android:textSize="@dimen/normal_text_size" />

                    <TextView
                        android:id="@+id/ittc_number_lead"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/tiny_margin"
                        android:textSize="@dimen/normal_text_size"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- (filled by the lead developer later) -->
            <LinearLayout
                android:id="@+id/ittc_number_lead_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- call / SMS / WhatsApp / save or open the contact / block -->
            <LinearLayout
                android:id="@+id/ittc_number_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/small_margin"
                android:paddingEnd="@dimen/small_margin">

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/ittc_number_call"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="@dimen/small_margin"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:paddingTop="@dimen/medium_margin"
                    android:paddingBottom="@dimen/medium_margin"
                    android:text="@string/ittc_hist_call"
                    android:textSize="@dimen/smaller_text_size" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/ittc_number_sms"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="@dimen/small_margin"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:paddingTop="@dimen/medium_margin"
                    android:paddingBottom="@dimen/medium_margin"
                    android:text="@string/ittc_hist_sms"
                    android:textSize="@dimen/smaller_text_size" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/ittc_number_whatsapp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="@dimen/small_margin"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:paddingTop="@dimen/medium_margin"
                    android:paddingBottom="@dimen/medium_margin"
                    android:text="@string/ittc_hist_whatsapp"
                    android:textSize="@dimen/smaller_text_size" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/ittc_number_contact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="@dimen/small_margin"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:paddingTop="@dimen/medium_margin"
                    android:paddingBottom="@dimen/medium_margin"
                    android:text="@string/ittc_hist_save"
                    android:textSize="@dimen/smaller_text_size" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/ittc_number_block"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:drawablePadding="@dimen/small_margin"
                    android:gravity="center_horizontal"
                    android:maxLines="1"
                    android:paddingTop="@dimen/medium_margin"
                    android:paddingBottom="@dimen/medium_margin"
                    android:text="@string/ittc_hist_block"
                    android:textSize="@dimen/smaller_text_size" />
            </LinearLayout>

            <org.fossify.commons.views.MyTextView
                android:id="@+id/ittc_number_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:alpha="0.8"
                android:paddingStart="@dimen/activity_margin"
                android:paddingEnd="@dimen/activity_margin"
                android:textSize="@dimen/normal_text_size" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/ittc_number_placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:gravity="center"
                android:padding="@dimen/activity_margin"
                android:text="@string/ittc_hist_none"
                android:textSize="@dimen/bigger_text_size"
                android:textStyle="italic"
                android:visibility="gone" />

            <!-- the calls, newest first, a date row per day (rows added in code) -->
            <LinearLayout
                android:id="@+id/ittc_number_calls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/ittc_number_delete"
                style="@style/IttcAboutRow"
                android:layout_marginTop="@dimen/medium_margin"
                android:drawablePadding="@dimen/medium_margin"
                android:paddingStart="@dimen/activity_margin"
                android:text="@string/ittc_hist_delete"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
