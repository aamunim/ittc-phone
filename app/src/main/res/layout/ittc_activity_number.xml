<?xml version="1.0" encoding="utf-8"?>
<!-- 🎓 ITTC: one number's call history — 3.5: a summary card on top, action tiles, a card per call by day -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ittc_number_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/ittc_number_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/ittc_number_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/ittc_hist_title"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/ittc_number_scrollview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/ittc_number_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/activity_margin">

            <!-- 🎨 the summary card: photo / initials, name, number, the lead, the call summary -->
            <LinearLayout
                android:id="@+id/ittc_number_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ittc_space_l"
                android:layout_marginTop="@dimen/ittc_space_m"
                android:layout_marginEnd="@dimen/ittc_space_l"
                android:background="@drawable/ittc_bg_card"
                android:orientation="vertical"
                android:padding="@dimen/ittc_space_l">

                <LinearLayout
                    android:id="@+id/ittc_number_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp">

                        <ImageView
                            android:id="@+id/ittc_number_photo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/ittc_number_initials"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:maxLines="1"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/ittc_number_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/ittc_text_headline"
                            android:textStyle="bold" />

                        <org.fossify.commons.views.MyTextView
                            android:id="@+id/ittc_number_number"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textIsSelectable="true"
                            android:textSize="13sp" />

                        <!-- the lead: "🎓 Rahim · CSE" and its stage pill -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/ittc_number_stage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/ittc_space_s"
                                android:maxLines="1"
                                android:paddingStart="@dimen/ittc_space_s"
                                android:paddingTop="2dp"
                                android:paddingEnd="@dimen/ittc_space_s"
                                android:paddingBottom="2dp"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/ittc_number_lead"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textSize="12sp"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- the lead's note and "Open lead" / "Templates" / "Add as a lead" -->
                <LinearLayout
                    android:id="@+id/ittc_number_lead_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ittc_space_m"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <View
                    android:id="@+id/ittc_number_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/ittc_space_m"
                    android:visibility="gone" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/ittc_number_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- call (teal) / SMS / WhatsApp / save or open the contact / block: tiles -->
            <LinearLayout
                android:id="@+id/ittc_number_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ittc_space_m"
                android:paddingTop="@dimen/ittc_space_m"
                android:paddingEnd="@dimen/ittc_space_m"
                android:paddingBottom="@dimen/ittc_space_xs">

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/ittc_number_call"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:layout_marginStart="@dimen/ittc_space_xs"
                    android:layout_marginEnd="@dimen/ittc_space_xs"
                    android:layout_weight="1"
                    android:drawablePadding="@dimen/ittc_space_xs"
                    android:ellipsize="end"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="2dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="8dp"
                    android:text="@string/ittc_hist_call"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/ittc_number_sms"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:layout_marginStart="@dimen/ittc_space_xs"
                    android:layout_marginEnd="@dimen/ittc_space_xs"
                    android:layout_weight="1"
                    android:drawablePadding="@dimen/ittc_space_xs"
                    android:ellipsize="end"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="2dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="8dp"
                    android:text="@string/ittc_hist_sms"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/ittc_number_whatsapp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:layout_marginStart="@dimen/ittc_space_xs"
                    android:layout_marginEnd="@dimen/ittc_space_xs"
                    android:layout_weight="1"
                    android:drawablePadding="@dimen/ittc_space_xs"
                    android:ellipsize="end"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="2dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="8dp"
                    android:text="@string/ittc_hist_whatsapp"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/ittc_number_contact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:layout_marginStart="@dimen/ittc_space_xs"
                    android:layout_marginEnd="@dimen/ittc_space_xs"
                    android:layout_weight="1"
                    android:drawablePadding="@dimen/ittc_space_xs"
                    android:ellipsize="end"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="2dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="8dp"
                    android:text="@string/ittc_hist_save"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/ittc_number_block"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="64dp"
                    android:layout_marginStart="@dimen/ittc_space_xs"
                    android:layout_marginEnd="@dimen/ittc_space_xs"
                    android:layout_weight="1"
                    android:drawablePadding="@dimen/ittc_space_xs"
                    android:ellipsize="end"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="2dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="8dp"
                    android:text="@string/ittc_hist_block"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <org.fossify.commons.views.MyTextView
                android:id="@+id/ittc_number_placeholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/activity_margin"
                android:text="@string/ittc_hist_none"
                android:textSize="@dimen/bigger_text_size"
                android:visibility="gone" />

            <!-- the calls, newest first: a day title, then a card per call (rows added in code) -->
            <LinearLayout
                android:id="@+id/ittc_number_calls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/ittc_number_delete"
                style="@style/IttcAboutRow"
                android:layout_marginTop="@dimen/medium_margin"
                android:drawablePadding="@dimen/medium_margin"
                android:paddingStart="@dimen/activity_margin"
                android:text="@string/ittc_hist_delete"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
