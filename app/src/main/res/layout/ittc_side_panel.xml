<?xml version="1.0" encoding="utf-8"?>
<!-- 🎓 ITTC Phone 3.12: the main screen's side panel (☰ or a swipe from the left edge): who is signed
     in, ITTC / Personal mode, the text size (live), dark theme, "Open with the dial pad", Settings
     and About. Colours set in code (IttcTheme). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ittc_panel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="false"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/ittc_panel_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/ittc_space_l">

        <!-- header -->
        <LinearLayout
            android:id="@+id/ittc_panel_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ittc_space_l"
            android:paddingTop="@dimen/ittc_space_xl"
            android:paddingEnd="@dimen/ittc_space_l"
            android:paddingBottom="@dimen/ittc_space_l">

            <TextView
                android:id="@+id/ittc_panel_avatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textSize="17dp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ittc_space_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ittc_panel_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ittc_panel_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- mode (signed in only) -->
        <LinearLayout
            android:id="@+id/ittc_panel_mode_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ittc_space_l"
            android:paddingEnd="@dimen/ittc_space_l"
            android:visibility="gone">

            <TextView
                android:id="@+id/ittc_panel_mode_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ittc_space_s"
                android:letterSpacing="0.06"
                android:text="@string/ittc_sp_mode"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/ittc_panel_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/ittc_panel_mode_ittc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:minHeight="40dp"
                    android:text="@string/ittc_sp_mode_ittc"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ittc_panel_mode_personal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:minHeight="40dp"
                    android:text="@string/ittc_sp_mode_personal"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- text size (live) -->
        <LinearLayout
            android:id="@+id/ittc_panel_text_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ittc_space_l"
            android:layout_marginTop="@dimen/ittc_space_l"
            android:layout_marginEnd="@dimen/ittc_space_l"
            android:orientation="vertical"
            android:padding="@dimen/ittc_space_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ittc_panel_text_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/ittc_sp_text_size"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ittc_panel_text_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/ittc_panel_text_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ittc_space_xs"
                android:minHeight="@dimen/ittc_touch" />
        </LinearLayout>

        <!-- toggles -->
        <RelativeLayout
            android:id="@+id/ittc_panel_dark_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ittc_space_s"
            android:background="?attr/selectableItemBackground"
            android:minHeight="52dp"
            android:paddingStart="@dimen/ittc_space_l"
            android:paddingEnd="@dimen/ittc_space_l">

            <org.fossify.commons.views.MyMaterialSwitch
                android:id="@+id/ittc_panel_dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:background="@null"
                android:clickable="false"
                android:minHeight="52dp"
                android:text="@string/ittc_sp_dark"
                android:textSize="15sp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/ittc_panel_dialpad_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:minHeight="52dp"
            android:paddingStart="@dimen/ittc_space_l"
            android:paddingEnd="@dimen/ittc_space_l">

            <org.fossify.commons.views.MyMaterialSwitch
                android:id="@+id/ittc_panel_dialpad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:background="@null"
                android:clickable="false"
                android:minHeight="52dp"
                android:text="@string/ittc_sp_open_dialpad"
                android:textSize="15sp" />
        </RelativeLayout>

        <View
            android:id="@+id/ittc_panel_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/ittc_space_s"
            android:layout_marginBottom="@dimen/ittc_space_s" />

        <!-- 🎓 3.12: ITTC & Personal mode's settings (signed in only) -->
        <TextView
            android:id="@+id/ittc_panel_mode_settings"
            style="@style/IttcPanelLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ittc_ic_mode_tile"
            android:text="@string/ittc_mode_settings"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ittc_panel_display"
            style="@style/IttcPanelLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ittc_ic_text_size"
            android:text="@string/ittc_sp_display" />

        <TextView
            android:id="@+id/ittc_panel_settings"
            style="@style/IttcPanelLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_settings_cog_vector"
            android:text="@string/ittc_sp_settings" />

        <TextView
            android:id="@+id/ittc_panel_about"
            style="@style/IttcPanelLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_info_vector"
            android:text="@string/ittc_sp_about" />
    </LinearLayout>
</ScrollView>
