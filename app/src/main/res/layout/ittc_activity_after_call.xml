<?xml version="1.0" encoding="utf-8"?>
<!-- 🎓 ITTC: after a lead call (not one started from the Tracker): the lead, how the call went, next steps -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ittc_ac_holder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/activity_margin">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/ittc_ac_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:alpha="0.8"
            android:textSize="@dimen/normal_text_size" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/ittc_ac_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/medium_margin"
            android:gravity="center_horizontal"
            android:textSize="26sp"
            android:textStyle="bold" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/ittc_ac_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tiny_margin"
            android:alpha="0.7"
            android:layoutDirection="ltr"
            android:textSize="@dimen/bigger_text_size" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/ittc_ac_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_margin"
            android:textSize="@dimen/bigger_text_size"
            android:textStyle="bold" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/ittc_ac_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_margin"
            android:gravity="center_horizontal"
            android:textSize="@dimen/bigger_text_size" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/ittc_ac_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/medium_margin"
            android:alpha="0.8"
            android:gravity="center_horizontal"
            android:maxLines="4"
            android:ellipsize="end"
            android:textSize="@dimen/normal_text_size"
            android:textStyle="italic" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <Button
            android:id="@+id/ittc_ac_add_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/ittc_add_note"
            android:textSize="@dimen/bigger_text_size" />

        <Button
            android:id="@+id/ittc_ac_call_again"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/medium_margin"
            android:minHeight="52dp"
            android:text="@string/ittc_call_again" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/medium_margin"
            android:orientation="horizontal">

            <Button
                android:id="@+id/ittc_ac_whatsapp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/medium_margin"
                android:layout_weight="1"
                android:minHeight="52dp"
                android:text="@string/ittc_whatsapp" />

            <Button
                android:id="@+id/ittc_ac_sms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="52dp"
                android:text="@string/ittc_sms" />
        </LinearLayout>

        <Button
            android:id="@+id/ittc_ac_open_lead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/medium_margin"
            android:minHeight="52dp"
            android:text="@string/ittc_open_lead" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/ittc_ac_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/medium_margin"
            android:background="?attr/selectableItemBackground"
            android:padding="@dimen/activity_margin"
            android:text="@string/ittc_close"
            android:textSize="@dimen/bigger_text_size" />
    </LinearLayout>
</ScrollView>
