<?xml version="1.0" encoding="utf-8"?>
<!-- 🎓 ITTC 3.5: after a lead call — a dark top (who, how the call went) and a white sheet (what
     happened, stage, note, next call, the list being called, Save). Colours are set in code
     (IttcTheme); outcome tiles and chips are added in code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ittc_ac_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ittc_incall_bg">

    <ScrollView
        android:id="@+id/ittc_ac_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ✕ close without saving (Back does the same) -->
            <TextView
                android:id="@+id/ittc_ac_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ittc_close"
                android:gravity="center"
                android:text="✕"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp" />

            <!-- (pushes the sheet to the bottom on a tall screen) -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="8dp" />

            <!-- the dark top: who, how the call went -->
            <LinearLayout
                android:id="@+id/ittc_ac_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/ittc_ac_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    tools:text="Call ended · Outgoing" />

                <TextView
                    android:id="@+id/ittc_ac_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="Lead name" />

                <TextView
                    android:id="@+id/ittc_ac_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layoutDirection="ltr"
                    android:textSize="14sp"
                    tools:text="01711-000000" />

                <TextView
                    android:id="@+id/ittc_ac_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Talked 4m 12s · CSE · Interested" />

                <TextView
                    android:id="@+id/ittc_ac_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/ittc_ac_today"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- the white sheet -->
            <LinearLayout
                android:id="@+id/ittc_ac_sheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ittc_bg_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <View
                    android:id="@+id/ittc_ac_handle"
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/ittc_ac_outcome_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="8dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="@string/ittc_what_happened" />

                <!-- 6 big tiles, 3 × 2 -->
                <LinearLayout
                    android:id="@+id/ittc_ac_outcomes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- 🧭 the pipeline stage -->
                <TextView
                    android:id="@+id/ittc_ac_stage_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="8dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="@string/ittc_b_stage"
                    android:visibility="gone" />

                <HorizontalScrollView
                    android:id="@+id/ittc_ac_stages_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/ittc_ac_stages"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/ittc_ac_stage_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- 📝 note: the admin's quick notes, then the note itself -->
                <TextView
                    android:id="@+id/ittc_ac_note_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="8dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="@string/ittc_b_note" />

                <HorizontalScrollView
                    android:id="@+id/ittc_ac_presets_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/ittc_ac_presets"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <EditText
                    android:id="@+id/ittc_ac_note_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/ittc_note_hint"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="4"
                    android:minHeight="48dp"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/ittc_ac_next_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="8dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="@string/ittc_next_call" />

                <HorizontalScrollView
                    android:id="@+id/ittc_ac_next_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/ittc_ac_next"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- ▶ calling a list: who is next, how many left, Stop -->
                <LinearLayout
                    android:id="@+id/ittc_ac_dialer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ittc_ac_dialer_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_play_vector" />

                    <TextView
                        android:id="@+id/ittc_ac_dialer_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/ittc_ac_stop"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:gravity="center"
                        android:minWidth="64dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/ittc_b_stop"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ittc_ac_save"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="@string/ittc_b_save"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- a number that is no lead: add it, or close -->
                <TextView
                    android:id="@+id/ittc_ac_add_lead"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/ittc_b_add_as_lead"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/ittc_ac_close_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:text="@string/ittc_close"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
