<?xml version="1.0" encoding="utf-8"?>
<!-- 🎓 ITTC: after a lead call (not one started from the Tracker): the lead, how the call went, next steps -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ittc_ac_holder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/activity_margin">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <org.fossify.commons.views.MyTextView
                android:id="@+id/ittc_ac_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:alpha="0.8"
                android:textSize="@dimen/normal_text_size" />

            <!-- ✕ close without saving (Back does the same) -->
            <org.fossify.commons.views.MyTextView
                android:id="@+id/ittc_ac_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|top"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ittc_close"
                android:gravity="center"
                android:text="✕"
                android:textSize="20sp" />
        </FrameLayout>

        <org.fossify.commons.views.MyTextView
            android:id="@+id/ittc_ac_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/medium_margin"
            android:gravity="center_horizontal"
            android:textSize="26sp"
            android:textStyle="bold" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/ittc_ac_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tiny_margin"
            android:alpha="0.7"
            android:layoutDirection="ltr"
            android:textSize="@dimen/bigger_text_size" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/ittc_ac_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_margin"
            android:textSize="@dimen/bigger_text_size"
            android:textStyle="bold" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/ittc_ac_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_margin"
            android:gravity="center_horizontal"
            android:textSize="@dimen/bigger_text_size" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/ittc_ac_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/medium_margin"
            android:alpha="0.8"
            android:gravity="center_horizontal"
            android:maxLines="4"
            android:ellipsize="end"
            android:textSize="@dimen/normal_text_size"
            android:textStyle="italic" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/ittc_ac_today"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_margin"
            android:alpha="0.75"
            android:textSize="@dimen/normal_text_size"
            android:visibility="gone" />

        <!-- 📝 the result, a note and the next call — saved here (Tracker 2.10.5+) -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/ittc_ac_outcome_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_margin"
            android:text="@string/ittc_what_happened"
            android:textSize="@dimen/normal_text_size"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/ittc_ac_outcomes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- 🧭 the pipeline stage (Tracker 2.10.6+; hidden with an older one) -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/ittc_ac_stage_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/activity_margin"
            android:text="@string/ittc_stage"
            android:textSize="@dimen/normal_text_size"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/ittc_ac_stages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/ittc_ac_stage_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/small_margin"
            android:alpha="0.8"
            android:textSize="@dimen/normal_text_size"
            android:visibility="gone" />

        <org.fossify.commons.views.MyEditText
            android:id="@+id/ittc_ac_note_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/medium_margin"
            android:hint="@string/ittc_note_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:textSize="@dimen/bigger_text_size" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/ittc_ac_next_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/medium_margin"
            android:text="@string/ittc_next_call"
            android:textSize="@dimen/normal_text_size"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/ittc_ac_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="@dimen/small_margin"
                android:paddingBottom="@dimen/small_margin" />
        </HorizontalScrollView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <Button
            android:id="@+id/ittc_ac_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/ittc_save"
            android:textSize="@dimen/bigger_text_size" />
    </LinearLayout>
</ScrollView>
