<?xml version="1.0" encoding="utf-8"?>
<!-- 🎓 ITTC: the "Leads" tab — open leads from the Tracker (a super admin: everyone's) -->
<org.fossify.phone.fragments.IttcLeadsFragment xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ittc_leads_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/ittc_leads_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 📊 Today: calls / connected / talk time (+ stage changes / new leads) and the target -->
        <LinearLayout
            android:id="@+id/ittc_leads_today"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/medium_margin"
            android:layout_marginTop="@dimen/small_margin"
            android:layout_marginEnd="@dimen/medium_margin"
            android:background="@drawable/ittc_chip_background"
            android:orientation="vertical"
            android:paddingStart="@dimen/activity_margin"
            android:paddingTop="@dimen/small_margin"
            android:paddingEnd="@dimen/small_margin"
            android:paddingBottom="@dimen/small_margin"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ittc_leads_today_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/normal_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ittc_leads_team"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ittc_chip_background"
                    android:paddingStart="@dimen/normal_margin"
                    android:paddingTop="@dimen/tiny_margin"
                    android:paddingEnd="@dimen/normal_margin"
                    android:paddingBottom="@dimen/tiny_margin"
                    android:text="@string/ittc_l2_team"
                    android:textSize="@dimen/normal_text_size"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/ittc_leads_today_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tiny_margin"
                android:textSize="@dimen/normal_text_size" />

            <ProgressBar
                android:id="@+id/ittc_leads_today_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/tiny_margin"
                android:layout_marginEnd="@dimen/small_margin"
                android:max="100"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ittc_leads_today_target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.8"
                android:textSize="@dimen/small_text_size"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ＋ Add lead (direct mode) · ▶ Call all (N) / ▶ Call next · ■ Stop -->
        <LinearLayout
            android:id="@+id/ittc_leads_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/medium_margin"
            android:paddingTop="@dimen/small_margin"
            android:paddingEnd="@dimen/medium_margin"
            android:visibility="gone">

            <TextView
                android:id="@+id/ittc_leads_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/small_margin"
                android:background="@drawable/ittc_chip_background"
                android:paddingStart="@dimen/normal_margin"
                android:paddingTop="@dimen/small_margin"
                android:paddingEnd="@dimen/normal_margin"
                android:paddingBottom="@dimen/small_margin"
                android:text="@string/ittc_l2_add_lead"
                android:textSize="@dimen/normal_text_size"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ittc_leads_call_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/small_margin"
                android:background="@drawable/ittc_chip_background"
                android:paddingStart="@dimen/normal_margin"
                android:paddingTop="@dimen/small_margin"
                android:paddingEnd="@dimen/normal_margin"
                android:paddingBottom="@dimen/small_margin"
                android:textSize="@dimen/normal_text_size"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ittc_leads_stop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ittc_chip_background"
                android:paddingStart="@dimen/normal_margin"
                android:paddingTop="@dimen/small_margin"
                android:paddingEnd="@dimen/normal_margin"
                android:paddingBottom="@dimen/small_margin"
                android:text="@string/ittc_l2_stop"
                android:textSize="@dimen/normal_text_size"
                android:visibility="gone" />
        </LinearLayout>

        <!-- whose leads (super admin) + today / overdue / new / hot / all -->
        <HorizontalScrollView
            android:id="@+id/ittc_leads_chips_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/ittc_leads_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/medium_margin"
                android:paddingTop="@dimen/small_margin"
                android:paddingEnd="@dimen/medium_margin"
                android:paddingBottom="@dimen/tiny_margin" />
        </HorizontalScrollView>

        <!-- pipeline stages -->
        <HorizontalScrollView
            android:id="@+id/ittc_leads_stages_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/ittc_leads_stages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/medium_margin"
                android:paddingTop="@dimen/tiny_margin"
                android:paddingEnd="@dimen/medium_margin"
                android:paddingBottom="@dimen/tiny_margin" />
        </HorizontalScrollView>

        <!-- "⟳ Updated 2 min ago" (tap: update now) / "the Tracker is closed" -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/ittc_leads_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="@dimen/activity_margin"
            android:paddingTop="@dimen/tiny_margin"
            android:paddingEnd="@dimen/activity_margin"
            android:paddingBottom="@dimen/tiny_margin"
            android:textSize="@dimen/small_text_size"
            android:visibility="gone" />
    </LinearLayout>

    <org.fossify.commons.views.MyTextView
        android:id="@+id/ittc_leads_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ittc_leads_header"
        android:alpha="0.8"
        android:gravity="center"
        android:padding="@dimen/activity_margin"
        android:textSize="@dimen/bigger_text_size"
        android:visibility="gone" />

    <org.fossify.commons.views.MyRecyclerView
        android:id="@+id/ittc_leads_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/ittc_leads_header"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/recyclerview_fab_padding"
        android:scrollbars="none"
        app:layoutManager="org.fossify.commons.views.MyLinearLayoutManager" />
</org.fossify.phone.fragments.IttcLeadsFragment>
