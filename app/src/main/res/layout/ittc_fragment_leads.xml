<?xml version="1.0" encoding="utf-8"?>
<!-- 🎓 ITTC: the "Leads" tab — open leads from the Tracker (a super admin: everyone's).
     3.5: the blue "Today" card with the target ring, pill chips, Call all / Add lead, lead cards. -->
<org.fossify.phone.fragments.IttcLeadsFragment xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ittc_leads_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/ittc_leads_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 📊 Today: the ring (calls / target), calls · connected · talk time, Team;
             3.8: the chevron in the corner folds it to one line ("Today: 12 calls · 8 connected · 34m") -->
        <FrameLayout
            android:id="@+id/ittc_leads_today"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ittc_space_l"
            android:layout_marginTop="@dimen/ittc_space_s"
            android:layout_marginEnd="@dimen/ittc_space_l"
            android:background="@drawable/ittc_bg_hero"
            android:padding="18dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/ittc_leads_today_full"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <org.fossify.phone.helpers.IttcRingView
                    android:id="@+id/ittc_leads_ring"
                    android:layout_width="88dp"
                    android:layout_height="88dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="24dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/ittc_leads_today_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ittc_leads_team"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/ittc_bg_pill_soft"
                            android:gravity="center"
                            android:minHeight="32dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/ittc_a_team"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ittc_space_s"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/ittc_leads_stat_calls"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/ittc_leads_stat_calls_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="@string/ittc_a_calls"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/ittc_leads_stat_connected"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/ittc_leads_stat_connected_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="@string/ittc_a_connected"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/ittc_leads_stat_talk"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/ittc_leads_stat_talk_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="@string/ittc_a_talk_time"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- stage changes · new leads (direct) / target reached -->
                    <TextView
                        android:id="@+id/ittc_leads_today_stats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textSize="11sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- folded: the day in one line (tap: open it again) -->
            <TextView
                android:id="@+id/ittc_leads_today_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:minHeight="36dp"
                android:paddingEnd="32dp"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- ⌃ fold / ⌄ open (its place and turn set in code) -->
            <ImageView
                android:id="@+id/ittc_leads_today_toggle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-10dp"
                android:layout_marginEnd="-10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ittc_l3_today_hide"
                android:padding="8dp"
                android:src="@drawable/ic_chevron_up_vector" />
        </FrameLayout>

        <!-- whose leads (super admin) + today / overdue / new / hot / all; 3.9: ☰ list / ▦ board at the end -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <HorizontalScrollView
            android:id="@+id/ittc_leads_chips_scroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fadingEdgeLength="24dp"
            android:overScrollMode="never"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/ittc_leads_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ittc_space_l"
                android:paddingTop="@dimen/ittc_space_m"
                android:paddingEnd="@dimen/ittc_space_s"
                android:paddingBottom="@dimen/ittc_space_xs" />
        </HorizontalScrollView>

            <!-- 3.9: ☰ list / ▦ board (the chosen one white on the soft track; remembered) -->
            <LinearLayout
                android:id="@+id/ittc_leads_view_toggle"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ittc_touch"
                android:layout_marginTop="@dimen/ittc_space_s"
                android:layout_marginEnd="@dimen/ittc_space_l"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ittc_leads_view_list"
                    android:layout_width="@dimen/ittc_touch"
                    android:layout_height="@dimen/ittc_touch"
                    android:contentDescription="@string/ittc_bd_view_list"
                    android:padding="12dp"
                    android:src="@drawable/ittc_ic_view_list" />

                <ImageView
                    android:id="@+id/ittc_leads_view_board"
                    android:layout_width="@dimen/ittc_touch"
                    android:layout_height="@dimen/ittc_touch"
                    android:contentDescription="@string/ittc_bd_view_board"
                    android:padding="12dp"
                    android:src="@drawable/ittc_ic_view_board" />
            </LinearLayout>
        </LinearLayout>

        <!-- pipeline stages -->
        <HorizontalScrollView
            android:id="@+id/ittc_leads_stages_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadingEdgeLength="24dp"
            android:overScrollMode="never"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/ittc_leads_stages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ittc_space_l"
                android:paddingTop="@dimen/ittc_space_s"
                android:paddingEnd="@dimen/ittc_space_s"
                android:paddingBottom="@dimen/ittc_space_xs" />
        </HorizontalScrollView>

        <!-- ▶ Call all (N) / ▶ Call next (teal) · ＋ Add lead (outline, direct mode) · ■ Stop -->
        <LinearLayout
            android:id="@+id/ittc_leads_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ittc_space_l"
            android:paddingTop="10dp"
            android:paddingEnd="@dimen/ittc_space_l"
            android:paddingBottom="@dimen/ittc_space_xs"
            android:visibility="gone">

            <TextView
                android:id="@+id/ittc_leads_call_all"
                android:layout_width="0dp"
                android:layout_height="@dimen/ittc_touch"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/ittc_bg_button_call"
                android:drawablePadding="@dimen/ittc_space_s"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="@dimen/ittc_space_l"
                android:paddingEnd="@dimen/ittc_space_l"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ittc_leads_add"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ittc_touch"
                android:background="@drawable/ittc_bg_pill_outline"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="@dimen/ittc_space_l"
                android:paddingEnd="@dimen/ittc_space_l"
                android:text="@string/ittc_a_add_lead"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ittc_leads_stop"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ittc_touch"
                android:layout_marginStart="10dp"
                android:background="@drawable/ittc_bg_pill_outline"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="@dimen/ittc_space_l"
                android:paddingEnd="@dimen/ittc_space_l"
                android:text="@string/ittc_a_stop"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- "⟳ Updated 2 min ago" (tap: update now) / "the Tracker is closed" -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/ittc_leads_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="20dp"
            android:paddingBottom="@dimen/ittc_space_xs"
            android:textSize="12sp"
            android:visibility="gone" />
        <!-- (until the first swipe) "Swipe right to call · swipe left to set the next call" -->
        <TextView
            android:id="@+id/ittc_leads_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="@dimen/ittc_space_l"
            android:paddingTop="@dimen/ittc_space_xs"
            android:paddingEnd="@dimen/ittc_space_l"
            android:text="@string/ittc_a_swipe_hint"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <org.fossify.commons.views.MyTextView
        android:id="@+id/ittc_leads_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ittc_leads_header"
        android:gravity="center"
        android:padding="@dimen/activity_margin"
        android:textSize="@dimen/bigger_text_size"
        android:visibility="gone" />

    <org.fossify.commons.views.MyRecyclerView
        android:id="@+id/ittc_leads_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/ittc_leads_header"
        android:clipToPadding="false"
        android:paddingTop="@dimen/ittc_space_xs"
        android:paddingBottom="@dimen/recyclerview_fab_padding"
        android:scrollbars="none"
        app:layoutManager="org.fossify.commons.views.MyLinearLayoutManager" />

    <!-- 3.9: the pipeline board — the stages as chips (● New 42; a tap goes to its column), then a
         column per stage side by side. While a card is dragged: the hint on top, "cancel" below. -->
    <LinearLayout
        android:id="@+id/ittc_leads_board"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/ittc_leads_header"
        android:orientation="vertical"
        android:visibility="gone">

        <HorizontalScrollView
            android:id="@+id/ittc_leads_board_chips_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadingEdgeLength="24dp"
            android:overScrollMode="never"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/ittc_leads_board_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ittc_space_l"
                android:paddingTop="@dimen/ittc_space_s"
                android:paddingEnd="@dimen/ittc_space_s"
                android:paddingBottom="@dimen/ittc_space_xs" />
        </HorizontalScrollView>

        <FrameLayout
            android:id="@+id/ittc_leads_board_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ittc_leads_board_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/ittc_space_l"
                android:paddingTop="@dimen/ittc_space_s"
                android:paddingEnd="@dimen/ittc_space_xs"
                android:paddingBottom="@dimen/ittc_space_l"
                android:scrollbars="none" />

            <!-- while dragging: what to do -->
            <TextView
                android:id="@+id/ittc_leads_board_hint"
                android:accessibilityLiveRegion="polite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginStart="@dimen/ittc_space_l"
                android:layout_marginTop="@dimen/ittc_space_xs"
                android:layout_marginEnd="@dimen/ittc_space_l"
                android:elevation="4dp"
                android:gravity="center"
                android:minHeight="40dp"
                android:paddingStart="@dimen/ittc_space_m"
                android:paddingEnd="@dimen/ittc_space_m"
                android:text="@string/ittc_bd_drop_hint"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- while dragging: dropped here, nothing changes -->
            <TextView
                android:id="@+id/ittc_leads_board_cancel"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="@dimen/ittc_space_l"
                android:layout_marginEnd="@dimen/ittc_space_l"
                android:layout_marginBottom="@dimen/ittc_space_m"
                android:elevation="4dp"
                android:gravity="center"
                android:text="@string/ittc_bd_drop_cancel"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- "Rahim moved to Interested   UNDO" (a few seconds) -->
            <LinearLayout
                android:id="@+id/ittc_leads_undo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginStart="@dimen/ittc_space_l"
                android:layout_marginTop="@dimen/ittc_space_xs"
                android:layout_marginEnd="@dimen/ittc_space_l"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ittc_space_l"
                android:paddingEnd="@dimen/ittc_space_xs"
                android:visibility="gone">

                <TextView
                    android:id="@+id/ittc_leads_undo_text"
                    android:accessibilityLiveRegion="polite"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:paddingTop="@dimen/ittc_space_s"
                    android:paddingBottom="@dimen/ittc_space_s"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/ittc_leads_undo_action"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/ittc_touch"
                    android:gravity="center"
                    android:minWidth="64dp"
                    android:paddingStart="@dimen/ittc_space_m"
                    android:paddingEnd="@dimen/ittc_space_m"
                    android:text="@string/ittc_bd_undo"
                    android:textAllCaps="true"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

</org.fossify.phone.fragments.IttcLeadsFragment>
