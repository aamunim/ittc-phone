<?xml version="1.0" encoding="utf-8"?>
<!-- 🎓 ITTC: the "Leads" tab — open leads from the Tracker (a super admin: everyone's).
     3.5: Call all / Add lead, lead cards. 3.10: a compact top — today's numbers in one row, one filter bar. -->
<org.fossify.phone.fragments.IttcLeadsFragment xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ittc_leads_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyTextView
        android:id="@+id/ittc_leads_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ittc_leads_header"
        android:gravity="center"
        android:padding="@dimen/activity_margin"
        android:textSize="@dimen/bigger_text_size"
        android:visibility="gone" />

    <org.fossify.commons.views.MyRecyclerView
        android:id="@+id/ittc_leads_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="@dimen/ittc_space_xs"
        android:paddingBottom="@dimen/recyclerview_fab_padding"
        android:scrollbars="none"
        app:layoutManager="org.fossify.commons.views.MyLinearLayoutManager" />

    <!-- 3.9: the pipeline board — a column per stage side by side (3.10: each column's header steps to
         the next / previous one or opens the list of stages). While a card is dragged: the hint and the
         stages as drop targets on top, "cancel" below. -->
    <LinearLayout
        android:id="@+id/ittc_leads_board"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/ittc_leads_header"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/ittc_leads_board_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ittc_leads_board_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/ittc_space_l"
                android:paddingTop="@dimen/ittc_space_s"
                android:paddingEnd="@dimen/ittc_space_xs"
                android:paddingBottom="@dimen/ittc_space_l"
                android:scrollbars="none" />

            <!-- while dragging: what to do, and (3.10) every stage as a small drop target, so a far
                 stage is one move away (the strip scrolls by itself near its ends) -->
            <LinearLayout
                android:id="@+id/ittc_leads_board_drag_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginStart="@dimen/ittc_space_l"
                android:layout_marginTop="@dimen/ittc_space_xs"
                android:layout_marginEnd="@dimen/ittc_space_l"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="@dimen/ittc_space_xs"
                android:visibility="gone">

                <TextView
                    android:id="@+id/ittc_leads_board_hint"
                    android:accessibilityLiveRegion="polite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="40dp"
                    android:paddingStart="@dimen/ittc_space_m"
                    android:paddingEnd="@dimen/ittc_space_m"
                    android:text="@string/ittc_bd_drop_hint"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:id="@+id/ittc_leads_board_chips_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fadingEdgeLength="24dp"
                    android:overScrollMode="never"
                    android:requiresFadingEdge="horizontal"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/ittc_leads_board_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/ittc_space_xs" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- while dragging: dropped here, nothing changes -->
            <TextView
                android:id="@+id/ittc_leads_board_cancel"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="@dimen/ittc_space_l"
                android:layout_marginEnd="@dimen/ittc_space_l"
                android:layout_marginBottom="@dimen/ittc_space_m"
                android:elevation="4dp"
                android:gravity="center"
                android:text="@string/ittc_bd_drop_cancel"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- "Rahim moved to Interested   UNDO" (a few seconds) -->
            <LinearLayout
                android:id="@+id/ittc_leads_undo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginStart="@dimen/ittc_space_l"
                android:layout_marginTop="@dimen/ittc_space_xs"
                android:layout_marginEnd="@dimen/ittc_space_l"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ittc_space_l"
                android:paddingEnd="@dimen/ittc_space_xs"
                android:visibility="gone">

                <TextView
                    android:id="@+id/ittc_leads_undo_text"
                    android:accessibilityLiveRegion="polite"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:paddingTop="@dimen/ittc_space_s"
                    android:paddingBottom="@dimen/ittc_space_s"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/ittc_leads_undo_action"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/ittc_touch"
                    android:gravity="center"
                    android:minWidth="64dp"
                    android:paddingStart="@dimen/ittc_space_m"
                    android:paddingEnd="@dimen/ittc_space_m"
                    android:text="@string/ittc_bd_undo"
                    android:textAllCaps="true"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- 3.10: the header lies over the top of the list (last here: drawn on top; its background set in
         code). The list keeps its full height with a top padding of the header's height, so folding the
         top away (the header's translationY) never moves the list. -->
    <LinearLayout
        android:id="@+id/ittc_leads_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical">

        <!-- 3.10: the compact top — today's numbers in one row and one filter bar; it folds away while
             the list scrolls down and comes back on the way up (gravity bottom: it slides up as it folds) -->
        <LinearLayout
            android:id="@+id/ittc_leads_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="vertical">

            <!-- 📊 Overdue N · Today N · Done today N · Target done/target › (a tap on Target: the day's details) -->
            <LinearLayout
                android:id="@+id/ittc_leads_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ittc_space_l"
                android:layout_marginTop="@dimen/ittc_space_s"
                android:layout_marginEnd="@dimen/ittc_space_l"
                android:orientation="horizontal"
                android:padding="@dimen/ittc_space_xs"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/ittc_leads_cell_overdue"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:minHeight="52dp"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ittc_space_xs"
                    android:paddingTop="6dp"
                    android:paddingEnd="@dimen/ittc_space_xs"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/ittc_leads_cell_overdue_n"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ittc_leads_cell_overdue_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:text="@string/ittc_cp_overdue"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ittc_leads_cell_today"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:minHeight="52dp"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ittc_space_xs"
                    android:paddingTop="6dp"
                    android:paddingEnd="@dimen/ittc_space_xs"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/ittc_leads_cell_today_n"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ittc_leads_cell_today_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:text="@string/ittc_cp_today"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ittc_leads_cell_done"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:minHeight="52dp"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ittc_space_xs"
                    android:paddingTop="6dp"
                    android:paddingEnd="@dimen/ittc_space_xs"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/ittc_leads_cell_done_n"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ittc_leads_cell_done_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:text="@string/ittc_cp_done"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ittc_leads_cell_target"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:minHeight="52dp"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ittc_space_xs"
                    android:paddingTop="6dp"
                    android:paddingEnd="@dimen/ittc_space_xs"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/ittc_leads_cell_target_n"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <!-- "Target ›" (the chevron set in code) -->
                    <TextView
                        android:id="@+id/ittc_leads_cell_target_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:drawablePadding="2dp"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:text="@string/ittc_cp_target"
                        android:textSize="11sp" />

                    <!-- today's numbers are the last ones kept (no internet) -->
                    <TextView
                        android:id="@+id/ittc_leads_cell_offline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:text="@string/ittc_a_offline"
                        android:textSize="10sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- one filter bar: [👤 whose · when ▾] [● stage ▾] [✕] … [☰ ▦] -->
            <LinearLayout
                android:id="@+id/ittc_leads_filters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ittc_space_l"
                android:paddingTop="@dimen/ittc_space_xs"
                android:paddingEnd="@dimen/ittc_space_l">

                <TextView
                    android:id="@+id/ittc_leads_scope_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/ittc_leads_stage_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/ittc_space_s"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- a 44 dp touch area around the 36 dp circle (inset in code) -->
                <ImageView
                    android:id="@+id/ittc_leads_clear"
                    android:layout_width="@dimen/ittc_touch"
                    android:layout_height="@dimen/ittc_touch"
                    android:layout_marginStart="4dp"
                    android:contentDescription="@string/ittc_cp_clear"
                    android:padding="13dp"
                    android:src="@drawable/ic_cross_vector"
                    android:visibility="gone" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- 3.11: 👤 My list / 👥 All list (one toggle; All in the soft accent; remembered) -->
                <ImageView
                    android:id="@+id/ittc_leads_whose"
                    android:layout_width="@dimen/ittc_touch"
                    android:layout_height="@dimen/ittc_touch"
                    android:layout_marginStart="@dimen/ittc_space_s"
                    android:contentDescription="@string/ittc_al_desc_my"
                    android:padding="12dp"
                    android:src="@drawable/ic_person_vector"
                    android:visibility="gone" />

                <!-- 3.9: ☰ list / ▦ board (the chosen one white on the soft track; remembered) -->
                <LinearLayout
                    android:id="@+id/ittc_leads_view_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/ittc_touch"
                    android:layout_marginStart="@dimen/ittc_space_s"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ittc_leads_view_list"
                        android:layout_width="@dimen/ittc_touch"
                        android:layout_height="@dimen/ittc_touch"
                        android:contentDescription="@string/ittc_bd_view_list"
                        android:padding="12dp"
                        android:src="@drawable/ittc_ic_view_list" />

                    <ImageView
                        android:id="@+id/ittc_leads_view_board"
                        android:layout_width="@dimen/ittc_touch"
                        android:layout_height="@dimen/ittc_touch"
                        android:contentDescription="@string/ittc_bd_view_board"
                        android:padding="12dp"
                        android:src="@drawable/ittc_ic_view_board" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ▶ Call all (N) / ▶ Call next (teal) · ＋ Add lead (outline, direct mode) · ■ Stop -->
        <LinearLayout
            android:id="@+id/ittc_leads_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ittc_space_l"
            android:paddingTop="10dp"
            android:paddingEnd="@dimen/ittc_space_l"
            android:paddingBottom="@dimen/ittc_space_xs"
            android:visibility="gone">

            <TextView
                android:id="@+id/ittc_leads_call_all"
                android:layout_width="0dp"
                android:layout_height="@dimen/ittc_touch"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/ittc_bg_button_call"
                android:drawablePadding="@dimen/ittc_space_s"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="@dimen/ittc_space_l"
                android:paddingEnd="@dimen/ittc_space_l"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ittc_leads_add"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ittc_touch"
                android:background="@drawable/ittc_bg_pill_outline"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="@dimen/ittc_space_l"
                android:paddingEnd="@dimen/ittc_space_l"
                android:text="@string/ittc_a_add_lead"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ittc_leads_stop"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ittc_touch"
                android:layout_marginStart="10dp"
                android:background="@drawable/ittc_bg_pill_outline"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="@dimen/ittc_space_l"
                android:paddingEnd="@dimen/ittc_space_l"
                android:text="@string/ittc_a_stop"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- "⟳ Updated 2 min ago" (tap: update now) / "the Tracker is closed" -->
        <org.fossify.commons.views.MyTextView
            android:id="@+id/ittc_leads_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="20dp"
            android:paddingBottom="@dimen/ittc_space_xs"
            android:textSize="12sp"
            android:visibility="gone" />
        <!-- (until the first swipe) "Swipe right to call · swipe left to set the next call" -->
        <TextView
            android:id="@+id/ittc_leads_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="@dimen/ittc_space_l"
            android:paddingTop="@dimen/ittc_space_xs"
            android:paddingEnd="@dimen/ittc_space_l"
            android:text="@string/ittc_a_swipe_hint"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

</org.fossify.phone.fragments.IttcLeadsFragment>
