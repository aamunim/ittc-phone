<?xml version="1.0" encoding="utf-8"?>
<!-- 🎓 ITTC Phone 3.12: Settings → Display & text size. A preview that follows the sliders, the text
     size (slider + 4 presets) and, folded, the other sizes. Colours and shapes are set in code
     (IttcTheme). -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ittc_ds_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/ittc_ds_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/ittc_ds_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/ittc_ds_title"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/ittc_ds_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/ittc_ds_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ittc_space_l"
            android:paddingTop="@dimen/ittc_space_s"
            android:paddingEnd="@dimen/ittc_space_l"
            android:paddingBottom="@dimen/ittc_space_xl">

            <!-- PREVIEW -->
            <TextView
                android:id="@+id/ittc_ds_preview_label"
                style="@style/IttcDisplayCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ittc_ds_preview" />

            <LinearLayout
                android:id="@+id/ittc_ds_preview_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:id="@+id/ittc_ds_preview_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="72dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ittc_ds_preview_avatar"
                        android:layout_width="@dimen/ittc_touch"
                        android:layout_height="@dimen/ittc_touch"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:textSize="15dp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ittc_space_m"
                        android:layout_marginEnd="@dimen/ittc_space_s"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/ittc_ds_preview_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ittc_ds_sample_name"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ittc_ds_preview_line"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ittc_space_xs"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ittc_ds_sample_line"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/ittc_ds_preview_due"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ittc_space_xs"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ittc_ds_sample_due"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/ittc_ds_preview_call"
                        android:layout_width="@dimen/ittc_touch"
                        android:layout_height="@dimen/ittc_touch"
                        android:importantForAccessibility="no"
                        android:padding="12dp"
                        android:src="@drawable/ic_phone_vector" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ittc_space_m"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ittc_ds_preview_save"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/ittc_space_s"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:minHeight="48dp"
                        android:paddingStart="@dimen/ittc_space_m"
                        android:paddingEnd="@dimen/ittc_space_m"
                        android:text="@string/ittc_ds_sample_save"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ittc_ds_preview_next"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:minHeight="48dp"
                        android:paddingStart="@dimen/ittc_space_m"
                        android:paddingEnd="@dimen/ittc_space_m"
                        android:text="@string/ittc_ds_sample_next"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- (with "More sizes" open: a dial pad key and the call screen's name) -->
                <LinearLayout
                    android:id="@+id/ittc_ds_preview_more"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ittc_space_m"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/ittc_ds_preview_key"
                        android:layout_width="@dimen/ittc_dp_key"
                        android:layout_height="@dimen/ittc_dp_key"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/ittc_ds_sample_key" />

                    <LinearLayout
                        android:id="@+id/ittc_ds_preview_call_screen"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ittc_space_m"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingTop="@dimen/ittc_space_s"
                        android:paddingBottom="@dimen/ittc_space_s">

                        <TextView
                            android:id="@+id/ittc_ds_preview_call_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ittc_ds_sample_name"
                            android:textSize="@dimen/caller_name_text_size" />

                        <TextView
                            android:id="@+id/ittc_ds_preview_call_number"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ittc_ds_sample_number"
                            android:textSize="@dimen/call_status_text_size" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- TEXT SIZE -->
            <TextView
                android:id="@+id/ittc_ds_text_label"
                style="@style/IttcDisplayCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ittc_space_l"
                android:text="@string/ittc_ds_text_size" />

            <LinearLayout
                android:id="@+id/ittc_ds_text_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ittc_space_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ittc_touch"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ittc_ds_a_small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/ittc_ds_smaller"
                        android:minWidth="@dimen/ittc_touch"
                        android:minHeight="@dimen/ittc_touch"
                        android:gravity="center"
                        android:text="A"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <SeekBar
                        android:id="@+id/ittc_ds_text_seek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="@dimen/ittc_touch" />

                    <TextView
                        android:id="@+id/ittc_ds_a_big"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/ittc_ds_bigger"
                        android:minWidth="@dimen/ittc_touch"
                        android:minHeight="@dimen/ittc_touch"
                        android:gravity="center"
                        android:text="A"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/ittc_ds_text_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ittc_space_xs"
                        android:gravity="end"
                        android:maxLines="1"
                        android:minEms="3"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ittc_ds_presets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ittc_space_m"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ittc_ds_preset_small"
                        style="@style/IttcDisplayPreset"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/ittc_ds_small" />

                    <TextView
                        android:id="@+id/ittc_ds_preset_normal"
                        style="@style/IttcDisplayPreset"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/ittc_ds_normal" />

                    <TextView
                        android:id="@+id/ittc_ds_preset_large"
                        style="@style/IttcDisplayPreset"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/ittc_ds_large" />

                    <TextView
                        android:id="@+id/ittc_ds_preset_extra"
                        style="@style/IttcDisplayPreset"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="0dp"
                        android:text="@string/ittc_ds_extra" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ittc_ds_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ittc_space_m"
                    android:text="@string/ittc_ds_note"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- MORE SIZES (folded) -->
            <LinearLayout
                android:id="@+id/ittc_ds_more_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ittc_space_l"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/ittc_ds_more_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ittc_space_l"
                    android:paddingEnd="@dimen/ittc_space_l">

                    <TextView
                        android:id="@+id/ittc_ds_more_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ittc_ds_more"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ittc_ds_more_chevron"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_down_vector" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ittc_ds_more_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ittc_space_l"
                    android:paddingEnd="@dimen/ittc_space_l"
                    android:paddingBottom="@dimen/ittc_space_l"
                    android:visibility="gone">

                    <LinearLayout
                        style="@style/IttcDisplaySliderHead"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/ittc_ds_rows_label"
                            style="@style/IttcDisplaySliderLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/ittc_ds_rows" />

                        <TextView
                            android:id="@+id/ittc_ds_rows_value"
                            style="@style/IttcDisplaySliderValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/ittc_ds_rows_seek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="2"
                        android:minHeight="@dimen/ittc_touch" />

                    <LinearLayout
                        style="@style/IttcDisplaySliderHead"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/ittc_ds_dialpad_label"
                            style="@style/IttcDisplaySliderLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/ittc_ds_dialpad" />

                        <TextView
                            android:id="@+id/ittc_ds_dialpad_value"
                            style="@style/IttcDisplaySliderValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/ittc_ds_dialpad_seek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="8"
                        android:minHeight="@dimen/ittc_touch" />

                    <LinearLayout
                        style="@style/IttcDisplaySliderHead"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/ittc_ds_call_label"
                            style="@style/IttcDisplaySliderLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/ittc_ds_call" />

                        <TextView
                            android:id="@+id/ittc_ds_call_value"
                            style="@style/IttcDisplaySliderValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/ittc_ds_call_seek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="10"
                        android:minHeight="@dimen/ittc_touch" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/ittc_ds_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/ittc_space_l"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingStart="@dimen/ittc_space_l"
                android:paddingEnd="@dimen/ittc_space_l"
                android:text="@string/ittc_ds_reset"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
