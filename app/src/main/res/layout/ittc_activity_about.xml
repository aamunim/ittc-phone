<?xml version="1.0" encoding="utf-8"?>
<!-- 🎓 ITTC Phone: About — the app, updates, its licence and source, credits -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ittc_about_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/ittc_about_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/ittc_about_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/about"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/ittc_about_scrollview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/ittc_about_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/activity_margin">

            <ImageView
                android:id="@+id/ittc_about_logo"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginTop="@dimen/activity_margin"
                android:contentDescription="@string/ittc_app_name"
                android:src="@drawable/ittc_logo" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/ittc_about_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:text="@string/ittc_app_name"
                android:textSize="24sp"
                android:textStyle="bold" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/ittc_about_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                android:textSize="@dimen/normal_text_size" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/ittc_about_tagline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/medium_margin"
                android:gravity="center_horizontal"
                android:text="@string/ittc_about_tagline"
                android:textSize="@dimen/bigger_text_size" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/ittc_about_update"
                style="@style/IttcAboutRow"
                android:layout_marginTop="@dimen/activity_margin"
                android:text="@string/ittc_about_update" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/ittc_about_tracker"
                style="@style/IttcAboutRow"
                android:text="@string/ittc_about_tracker" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/ittc_about_privacy"
                style="@style/IttcAboutRow"
                android:text="@string/ittc_about_privacy" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/ittc_about_source"
                style="@style/IttcAboutRow"
                android:text="@string/ittc_about_source" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/ittc_about_licence"
                style="@style/IttcAboutRow"
                android:text="@string/ittc_about_licence" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/ittc_about_libraries"
                style="@style/IttcAboutRow"
                android:text="@string/ittc_about_libraries" />

            <!-- (the GPL's "appropriate legal notices": the original authors and the licence stay credited) -->
            <org.fossify.commons.views.MyTextView
                android:id="@+id/ittc_about_credit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_margin"
                android:alpha="0.6"
                android:gravity="center_horizontal"
                android:text="@string/ittc_about_credit"
                android:textSize="@dimen/small_text_size" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
