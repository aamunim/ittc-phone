<?xml version="1.0" encoding="utf-8"?>
<!-- 🎓 ITTC Phone 3.12: Display & text size and the side panel (colours set in code) -->
<resources>
    <style name="IttcDisplayCaption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/ittc_space_xs</item>
        <item name="android:layout_marginBottom">@dimen/ittc_space_s</item>
        <item name="android:layout_marginTop">@dimen/ittc_space_s</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="IttcDisplayPreset">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">@dimen/ittc_space_s</item>
        <item name="android:minHeight">@dimen/ittc_touch</item>
        <item name="android:gravity">center</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">@dimen/ittc_space_xs</item>
        <item name="android:paddingEnd">@dimen/ittc_space_xs</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="IttcDisplaySliderHead">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/ittc_space_m</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="IttcDisplaySliderLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="IttcDisplaySliderValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/ittc_space_s</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- the side panel: a row with a switch, and a link -->
    <style name="IttcPanelLink">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:drawablePadding">@dimen/ittc_space_l</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/ittc_space_l</item>
        <item name="android:paddingEnd">@dimen/ittc_space_l</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
