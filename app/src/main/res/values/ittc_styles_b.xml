<?xml version="1.0" encoding="utf-8"?>
<!-- 🎨 ITTC 3.5 (lead page): the big action buttons and the section heads (colours set in code) -->
<resources>
    <style name="IttcLeadAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/ittc_bg_card</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="IttcLeadSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/ittc_space_l</item>
        <item name="android:layout_marginTop">@dimen/ittc_space_l</item>
        <item name="android:layout_marginEnd">@dimen/ittc_space_l</item>
        <item name="android:layout_marginBottom">@dimen/ittc_space_s</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
